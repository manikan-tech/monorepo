# ─── Licensed SMPL model files — NEVER commit ───────────────────────────
# These are large (~38–53 MB each) and covered by the SMPL license
# (research license for ITI; commercial license required post-graduation).
# Each developer must obtain and place them locally.
# See models/smpl/README.md for setup instructions.
models/smpl/*.pkl
models/smpl/*.npz

# ─── Python ─────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]

# ─── Local artifacts ────────────────────────────────────────────────────
*.glb
.env

# ─── Drape-bake scratch (regeneratable from a real bake run) ────────────
# Raw per-point simulation inputs/outputs and one-off backups: large binary
# .npz files with no value once baked into models/garments/*/delta_library.npz.
# Keep only the tool scripts and the final result manifests (small, referenced
# from docs/known-issues.md as the evidence trail).
tools/drape_bake/_pilot_inputs/
tools/drape_bake/_pilot_outputs/
tools/drape_bake/_prebake_backup/
tools/drape_bake/_test_pose_inputs/
tools/drape_bake/_test_pose_outputs/
tools/drape_bake/_qa_*.npz
tools/drape_bake/_qa_renders/
tools/drape_bake/_test_*.npz
tools/drape_bake/_test_pose_*.py
