# Recommendation Service — environment template
# Copy to .env and fill in real values.
# Never commit .env — it is gitignored.
#
# Generate secrets with: openssl rand -hex 32

# ── LLM (Required) ────────────────────────────────────────────────────────────
# Primary and only LLM provider. No fallback chain exists.
# Without this key every LLM-dependent response returns STATIC-DEGRADED.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# ── Internal Service Auth (Required) ──────────────────────────────────────────
# Shared secret validated on every inbound request from the Next.js gateway.
# Must match RECOMMENDATION_SERVICE_KEY set in the Next.js store environment.
# Both env var names are accepted (AliasChoices) — configure only ONE.
RECOMMENDATION_SERVICE_KEY=<generate-with-openssl-rand-hex-32>
# RECOMMEND_SERVICE_KEY=<same-value-alternative-name>

# Previous key accepted during zero-downtime rotation — remove once complete.
# RECOMMENDATION_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>
# RECOMMEND_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>

# ── Store Connection — Remote pgvector RAG (Optional) ─────────────────────────
# Base URL of the Next.js store. FastAPI calls /api/products/search on this
# host for semantic vector retrieval. If unreachable, service falls back to
# local TF-IDF automatically — no configuration needed for fallback.
# LOCAL DEFAULT — must not be relied on in production.
STORE_BASE_URL=http://localhost:3000

# Override when the store service URL differs from STORE_BASE_URL:
# STORE_SERVICE_BASE_URL=

# HTTP timeout for remote RAG calls in seconds (default: 5.0).
# STORE_SERVICE_RAG_TIMEOUT_SECONDS=5.0

# ── CORS (Optional) ───────────────────────────────────────────────────────────
# Comma-separated allowed origins. Default covers local dev only.
# In production set to your actual frontend origin(s).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Port (Optional) ───────────────────────────────────────────────────────────
# Dockerfile default is 8002. Override here or via docker run -e PORT=...
# LOCAL DEFAULT — do not treat any specific port as a production requirement.
# PORT=8002

# ── Declared but currently unused ─────────────────────────────────────────────
# HF_TOKEN / HUGGINGFACE_API_KEY are declared in config.py but are not wired
# to any active code path in the current release. Do NOT configure for
# deployment — they have no effect.
# HF_TOKEN=
# HUGGINGFACE_API_KEY=
