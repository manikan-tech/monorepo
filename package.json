{
  "name": "manikan-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start:body": "cd services-python/body-service && . .venv/bin/activate && uvicorn app.main:app --reload --port 8001",
    "start:ai": "cd services-python/recommendation-service && . .venv/bin/activate && uvicorn app.main:app --reload --port 8002",
    "start:vton": "cd services-python/tryon-service && . .venv/bin/activate && uvicorn main:app --reload --port 8003"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}