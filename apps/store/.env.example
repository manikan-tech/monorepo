# Copy this file to `.env` and fill in real values (ask a teammate for the
# shared Supabase credentials — do NOT commit .env, it's already gitignored).

# --- Prisma Database Connections (shared team Supabase project) ---

# Pooled connection — used by the Next.js app at runtime (via pgBouncer, port 6543)
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used ONLY by `prisma migrate` (port 5432)
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"

# --- Supabase Client Config ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_KEY=<service-key>

# --- Auth ---
# Any long random string works — this only needs to be consistent for YOUR
# own local dev server; it does not need to match teammates. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=<generate-locally>

# --- Body Service (Python SMPL engine) — proxied by /api/tryon and /api/avatar ---
BODY_SERVICE_URL=http://localhost:8001
# Generate with: openssl rand -hex 32. Never expose this as NEXT_PUBLIC_*, put
# it in client code, or reuse the public retailer widget key. body-service has
# no other auth of its own, so this is what stops it being called by anything
# other than this proxy. *_PREVIOUS is optional during rotation.
BODY_SERVICE_KEY=<generate-locally>
# BODY_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>

# --- 2D VTON service-to-service gate ---
# Generate with: openssl rand -hex 32. Never expose this as NEXT_PUBLIC_*, put
# it in client code, or reuse the public retailer widget key. Configure the
# same value in every Next.js instance. *_PREVIOUS is optional during rotation.
VTON_2D_SERVICE_KEY=<generate-locally>
# VTON_2D_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>

# Separate secret tryon-service itself verifies (distinct from VTON_2D_SERVICE_KEY
# above, which only guards the /api/vton/2d Next.js-internal hop). Generate with:
# openssl rand -hex 32. Must match TRYON_SERVICE_KEY in tryon-service's own env.
TRYON_SERVICE_KEY=<generate-locally>
# TRYON_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>

# --- Recommendation Service (LangGraph agent) — proxied by /api/widget/recommend ---
RECOMMENDATION_SERVICE_URL=http://localhost:8002
# Generate with: openssl rand -hex 32. Must match RECOMMENDATION_SERVICE_KEY in
# recommendation-service's own env.
RECOMMENDATION_SERVICE_KEY=<generate-locally>
# RECOMMENDATION_SERVICE_KEY_PREVIOUS=<old-key-during-rotation>

# Comma-separated hostnames for the controlled product-image CDN/storage used
# by the VTON worker. Required: this prevents retailer-supplied image URLs from
# becoming SSRF requests from the Python service. The seeded catalog assets use
# the public `catalog` bucket in this Supabase project.
VTON_ALLOWED_IMAGE_HOSTS=<project-ref>.supabase.co

# --- Stripe billing (server-side only) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...



# --- Size chart ingestion ---
# Private Supabase Storage bucket holding retailer-uploaded measurement CSVs.
# Must be created manually (no infra-as-code for Storage in this repo).
SIZE_CHART_BUCKET=size-charts
