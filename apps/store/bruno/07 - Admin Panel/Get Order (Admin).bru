meta {
  name: Get Order (Admin)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/admin/orders/{{orderId}}
  body: none
  auth: none
}

docs {
  ## GET /api/admin/orders/:id

  Fetches full order details for any customer — admin scoped (no ownership check).
  Used for support and order management in the admin dashboard.

  ### Success (200)
  ```json
  {
    "order": {
      "id": "...",
      "status": "PENDING",
      "totalEgp": 860,
      "customer": { "email": "customer@example.com" },
      "items": [...]
    }
  }
  ```
}
