post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

docs {
  ## POST /api/auth/logout

  Signs out the currently authenticated user by invalidating
  the Supabase session and clearing the `manikan_role` cookie.

  ### Success (200)
  ```json
  { "success": true }
  ```
}
