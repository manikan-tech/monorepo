meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "customer@example.com",
    "password": "Password123!",
    "role": "customer"
  }
}

docs {
  ## POST /api/auth/login

  Authenticates a user (Customer *or* Retailer) via Supabase Auth.

  ### Body
  | Field    | Type   | Required | Description                                      |
  |----------|--------|----------|--------------------------------------------------|
  | email    | string | ✅       | User's email address                             |
  | password | string | ✅       | User's password                                  |
  | role     | string | ❌       | `"customer"` or `"retailer"` — helps disambiguate |

  ### Success (200)
  ```json
  {
    "success": true,
    "redirect": "/",
    "user": { "id": "...", "email": "customer@example.com", "role": "customer" }
  }
  ```

  ### Notes
  - Platform admins are **blocked** from this endpoint (use `/admin`).
  - If the email is unconfirmed, `requiresActivation: true` is returned.
  - A session cookie (`manikan_role`) is set on success.
}
