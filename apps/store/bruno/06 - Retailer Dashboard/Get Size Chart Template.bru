meta {
  name: Get Size Chart Template
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/retailer/size-charts/template?category=shirt
  body: none
  auth: none
}

docs {
  ## GET /api/retailer/size-charts/template

  Returns a blank size chart template (column headers + example row)
  as a downloadable CSV for the given product category.

  ### Query Parameters
  | Param    | Type   | Required | Description                              |
  |----------|--------|----------|------------------------------------------|
  | category | string | ✅       | Product category (e.g. `shirt`, `pants`) |

  ### Response
  ```
  Content-Type: text/csv
  Content-Disposition: attachment; filename="size-chart-template-shirt.csv"
  ```
  ```csv
  size_label,chest_cm,waist_cm,hip_cm,length_cm
  S,88,74,90,70
  M,94,80,96,72
  ```
}
