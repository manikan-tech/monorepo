generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Enums ──────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  RETURN_PENDING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AuditAction {
  ACTIVATED
  SUSPENDED
  PLAN_CHANGED
}

// ─── B2B: Retailer (existing) ───────────────────────────────────

model PlatformAdmin {
  id        String    @id @default(cuid())
  authId    String    @unique
  email     String    @unique
  role      AdminRole @default(SUPPORT)
  createdAt DateTime  @default(now())

  auditLogs RetailerAuditLog[]
}

model Retailer {
  id             String   @id @default(cuid())
  authId         String   @unique
  email          String   @unique
  storeName      String
  hashedPassword String?
  isActivated    Boolean  @default(false)
  apiKey         String   @unique @default(cuid())
  plan           String   @default("free")
  widgetSettings Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products         Product[]
  sessions         MeasurementSession[]
  subscriptions    Subscription[]
  billingCheckouts BillingCheckout[]
  originAllowlist  OriginAllowlist[]
  vtonCacheEntries VtonCacheEntry[]
  auditLogs        RetailerAuditLog[]
}

// ─── SaaS billing ──────────────────────────────────────────────

// Stripe identifiers are only written by verified Stripe webhooks. Historical
// rows are retained so delayed events cannot overwrite a newer subscription.
model Subscription {
  id                   String             @id @default(cuid())
  retailerId           String
  stripeCustomerId     String
  // Legacy rows may not have a Stripe subscription ID. New webhook-created
  // rows always provide one and are the only rows eligible for state changes.
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(PAST_DUE)
  lastStripeEventAt    Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([retailerId, status])
  @@index([stripeCustomerId])
}

// A Checkout Session is created only by an authenticated server-side flow and
// recorded before redirecting the retailer to Stripe. Webhooks use this record
// as the tenant authority instead of trusting event metadata.
model BillingCheckout {
  stripeCheckoutSessionId String   @id
  retailerId              String
  createdAt               DateTime @default(now())

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
}

// Tenant-owned Origins used by VTON developer tooling. Origin values are
// normalized before persistence so equivalent values cannot bypass the limit.
model OriginAllowlist {
  id         String   @id @default(cuid())
  retailerId String
  origin     String
  createdAt  DateTime @default(now())

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([retailerId, origin])
  @@index([retailerId])
}

// Metadata for cached VTON work. Cache data is isolated by retailer and must
// never be queried or invalidated without the retailerId predicate.
model VtonCacheEntry {
  id         String   @id @default(cuid())
  retailerId String
  cacheKey   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([retailerId, cacheKey])
  @@index([retailerId, updatedAt])
}

// Stripe retries deliveries until a 2xx response is returned. Storing the
// event ID makes all state transitions idempotent across retries and deploys.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─── Audit Logs ─────────────────────────────────────────────────

model RetailerAuditLog {
  id         String      @id @default(cuid())
  retailerId String
  adminId    String
  action     AuditAction
  reason     String?
  createdAt  DateTime    @default(now())

  retailer Retailer      @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  admin    PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// ─── Category ───────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  parentId    String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Product (extended) ─────────────────────────────────────────

model Product {
  id          String                       @id @default(cuid())
  retailerId  String
  categoryId  String?
  productCode String
  name        String
  slug        String                       @unique
  description String?
  category    String
  gender      String
  brand       String
  fabric      String
  priceEgp    Float
  discountPct Float                        @default(0)
  imageUrl    String
  images      String[]
  stock       Int                          @default(0)
  isActive    Boolean                      @default(true)
  embedding   Unsupported("vector(1536)")?
  tshirtColorHex String?                    // garment colour (hex) for the 3D virtual try-on
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  retailer       Retailer             @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  categoryRef    Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  sessions       MeasurementSession[]
  cartItems      CartItem[]
  wishlistItems  Wishlist[]
  reviews        Review[]
  orderItems     OrderItem[]

  @@unique([retailerId, productCode])
}

// ─── Product Variant (extended) ─────────────────────────────────

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  sku            String  @unique
  sizeLabel      String
  priceOverride  Float?
  stock          Int     @default(0)
  chestCm        Float?
  waistCm        Float?
  hipCm          Float?
  lengthCm       Float?
  inseamCm       Float?
  // ─── Flat garment measurements — used by the 3D virtual try-on engine ───
  garmentChestCm     Float?
  garmentLengthCm    Float?
  garmentSleeveCm    Float?
  garmentShoulderCm  Float?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

// ─── Customer ───────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  authId    String   @unique
  email     String   @unique
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses  Address[]
  cartItems  CartItem[]
  wishlist   Wishlist[]
  orders     Order[]
  reviews    Review[]
  sessions   MeasurementSession[]
}

// ─── Address ────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  customerId String
  label      String  @default("Home")
  street     String
  city       String
  state      String
  zipCode    String?
  country    String  @default("Egypt")
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Cart ───────────────────────────────────────────────────────

model CartItem {
  id         String @id @default(cuid())
  customerId String
  productId  String
  variantId  String
  quantity   Int    @default(1)

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId, variantId])
}

// ─── Wishlist ───────────────────────────────────────────────────

model Wishlist {
  id         String @id @default(cuid())
  customerId String
  productId  String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
}

// ─── Order ──────────────────────────────────────────────────────

model Order {
  id             String        @id @default(cuid())
  customerId     String
  addressId      String?
  status         OrderStatus   @default(PENDING)
  subtotalEgp    Float
  shippingEgp    Float         @default(0)
  discountEgp    Float         @default(0)
  totalEgp       Float
  paymentMethod  String?
  paymentStatus  PaymentStatus @default(PENDING)
  trackingNumber String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address  Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items    OrderItem[]
}

// ─── Order Item ─────────────────────────────────────────────────

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  quantity     Int
  unitPriceEgp Float
  sizeLabel    String

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ─── Review ─────────────────────────────────────────────────────

model Review {
  id         String  @id @default(cuid())
  customerId String
  productId  String
  rating     Int
  title      String?
  comment    String?
  isVerified Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId])
}

// ─── Business Inquiry (lead capture) ────────────────────────────

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model BusinessInquiry {
  id            String        @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?
  website       String?
  monthlyOrders String?       // "Under 100" | "100–1,000" | "1,000+"
  message       String?
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
}

// ─── Measurement Session (extended) ─────────────────────────────

model MeasurementSession {
  id                 String   @id @default(cuid())
  retailerId         String
  customerId         String?
  shopperRef         String?  // anonymous visitor token (MVP Tier 2) — see docs/enterprise-roadmap.md
  productId          String
  heightCm           Float
  weightKg           Float
  chestCm            Float
  waistCm            Float
  hipsCm             Float
  measurementVersion String   @default("v1")
  bodyShapeParams    Json?
  recommendedSize    String?
  confidenceScore    Float?
  explanation        String?
  tryonResultUrl     String?
  isPurchased        Boolean  @default(false)
  createdAt          DateTime @default(now())

  retailer Retailer  @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}
