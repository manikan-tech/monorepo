# Base URL of the Store service (Next.js). The widget calls the Store, which
# proxies to the Python body-service — the widget never calls Python directly.
VITE_STORE_API_URL=http://localhost:3000

# Public retailer key, sent as the X-Manikan-Key header (Phase 3b auth).
# For the dev demo, set this to the seeded demo retailer's apiKey.
VITE_MANIKAN_KEY=your_public_retailer_key
