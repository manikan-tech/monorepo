{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "src/**/*",
        "app/**/*",
        "package.json",
        "tsconfig.json",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ],
      "inputs": [
        "src/**/*",
        "app/**/*",
        "tsconfig.json",
        "package.json",
        "**/*.ts",
        "**/*.tsx"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}