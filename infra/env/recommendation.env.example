# Private runtime configuration for the Recommendation container.
# Copy to infra/env/recommendation.env; never commit the copy.
# The internal key must exactly match Store's RECOMMENDATION_SERVICE_KEY.
RECOMMENDATION_SERVICE_KEY=<same-value-as-store.env>
DEEPSEEK_API_KEY=<DeepSeek API key>

# Recommendation reaches Store only over the private Compose network for RAG.
STORE_BASE_URL=http://store:3000

# Browsers never call Recommendation directly; Store-to-Recommendation
# authorization is enforced with RECOMMENDATION_SERVICE_KEY.
ALLOWED_ORIGINS=http://store:3000
