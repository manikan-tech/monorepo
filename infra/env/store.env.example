# Private runtime configuration for the Store container.
# Copy to infra/env/store.env; never commit the copy.
DATABASE_URL=<Supabase pooled PostgreSQL URL>
DIRECT_URL=<Supabase direct PostgreSQL URL>
SUPABASE_SERVICE_KEY=<Supabase server-side service-role key>
JWT_SECRET=<long-random-secret>
BODY_SERVICE_KEY=<same-value-as-body.env>
# Server-only Store -> Recommendation credential. Do not expose this as a
# NEXT_PUBLIC_* variable or embed it in a widget.
RECOMMENDATION_SERVICE_URL=http://recommendation:8002
RECOMMENDATION_SERVICE_KEY=<same-value-as-recommendation.env>
# Store -> VTON stays on the private Compose network. The internal key must
# exactly match vton.env and is never browser-visible.
VTON_SERVICE_URL=http://vton:8003
TRYON_SERVICE_KEY=<same-value-as-vton.env>
# Server-only retailer-scoped VTON_2D key used by the customer proxy when it
# calls Store's protected VTON route.
VTON_2D_SERVICE_KEY=<retailer-vton-2d-service-key>
# Comma-separated public image hosts permitted for the VTON product image.
VTON_ALLOWED_IMAGE_HOSTS=<approved-catalog-image-host>
# Shared private credential for the Telegram bot to call /api/bot/user.
# This exact value must also be set as BOT_API_SECRET in bot.env.
BOT_API_SECRET=<long-random-secret>
# Per-customer calendar-month allowance for successful Telegram VTON requests.
BOT_MONTHLY_QUOTA=5
# Browser-facing HTTPS origin used server-side when generating absolute product
# image URLs for Body. Example: https://store.example.com
STORE_PUBLIC_URL=https://store.example.com

# Keep existing Store server-side settings that your app uses, for example:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SIZE_CHART_BUCKET=size-charts

# Public values are also supplied at runtime for server-side code. They must
# match the build-time values in compose.env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_MANIKAN_WIDGET_KEY=<public-widget-key>
NEXT_PUBLIC_MANIKAN_RECOMMEND_KEY=<public-recommend-key>
NEXT_PUBLIC_WIDGET_API_KEY=<public-recommendation-service-key>
