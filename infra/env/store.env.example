# Private runtime configuration for the Store container.
# Copy to infra/env/store.env; never commit the copy.
DATABASE_URL=<Supabase pooled PostgreSQL URL>
DIRECT_URL=<Supabase direct PostgreSQL URL>
SUPABASE_SERVICE_KEY=<Supabase server-side service-role key>
JWT_SECRET=<long-random-secret>
BODY_SERVICE_KEY=<same-value-as-body.env>
# Browser-facing HTTPS origin used server-side when generating absolute product
# image URLs for Body. Example: https://store.example.com
STORE_PUBLIC_URL=https://store.example.com

# Keep existing Store server-side settings that your app uses, for example:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SIZE_CHART_BUCKET=size-charts

# Public values are also supplied at runtime for server-side code. They must
# match the build-time values in compose.env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_MANIKAN_WIDGET_KEY=<public-widget-key>
NEXT_PUBLIC_MANIKAN_RECOMMEND_KEY=<public-recommend-key>
NEXT_PUBLIC_WIDGET_API_KEY=<public-recommendation-service-key>
