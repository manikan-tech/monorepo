# Private Telegram bot environment. Copy to infra/env/bot.env; never commit it.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>

# Private Docker-network endpoints. Do not use localhost on EC2.
FASTAPI_URL=http://vton:8003/api/vton/2d
FASTAPI_TIMEOUT=120
TRYON_SERVICE_KEY=<same-value-as-vton.env>
STORE_API_URL=http://store:3000/api/bot/user
BOT_API_SECRET=<same-value-as-store.env>

# Per-customer calendar-month allowance for successful Telegram VTON requests.
BOT_MONTHLY_QUOTA=5
# Public URL shown to users after their quota is used. Set a real checkout page
# before enabling paid top-ups.
CHECKOUT_URL=https://store.example.com/
