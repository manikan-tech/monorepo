# Copy to infra/env/compose.env locally or on the EC2 host. Do not commit it.
# Used by `docker compose --env-file infra/env/compose.env ...`.

# Public reverse-proxy address. `:80` is suitable for a local HTTP test.
# Use your real domain (without http://) on EC2 to enable Caddy automatic TLS.
CADDY_SITE_ADDRESS=:80
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Private environment files. These paths are evaluated relative to
# infra/compose.production.yml.
STORE_ENV_FILE=./env/store.env
BODY_ENV_FILE=./env/body.env
RECOMMENDATION_ENV_FILE=./env/recommendation.env

# Licensed SMPL assets stay outside the image and Git. This directory contains
# `SMPL_MALE.pkl` and `SMPL_FEMALE.pkl` directly.
BODY_MODEL_HOST_DIR=/opt/manikan/body-models/smpl
MAX_CONCURRENT_GENERATIONS=1
BODY_CORS_ORIGINS=http://store:3000
STORE_PUBLIC_URL=https://store.example.com

# Build-time public configuration. These are intentionally public values, but
# keep them in one deploy file so the Store image is reproducible.
VITE_STORE_API_URL=https://store.example.com
NEXT_PUBLIC_BASE_URL=https://store.example.com
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_MANIKAN_WIDGET_KEY=<public-widget-key>
NEXT_PUBLIC_MANIKAN_RECOMMEND_KEY=<public-recommend-key>
NEXT_PUBLIC_WIDGET_API_KEY=<public-recommendation-service-key>
